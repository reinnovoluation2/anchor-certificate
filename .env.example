# .env 에 넣어야 할 값의 이름 목록입니다.
# 이 파일은 값이 비어 있으므로 커밋해도 됩니다. (CLAUDE.md 5번)
# 실제 값은 .env 에 넣으세요. .env 는 절대 커밋하지 않습니다.

# ── 담당자 공용 계정 ──
ADMIN_ID=
# 숫자 네 자리. 담당자가 화면에서 바꾸면 그때부터 저장소 값이 우선합니다.
ADMIN_PASSWORD=

# 로그인 표시(쿠키)와 재설정 링크를 위조하지 못하게 막는 임의의 긴 문자열
SESSION_SECRET=

# ── 데이터 창고 (Supabase) ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase CLI 작업용 (CLAUDE.md 6번)
SUPABASE_ACCESS_TOKEN=

# ── 비밀번호 재설정 메일 ──
# 재설정 링크를 받을 사업단 공용 메일 주소. 이 한 곳으로만 갑니다.
ADMIN_EMAIL=

# 보내는 사람으로 찍힐 주소
MAIL_FROM=

# 아래 둘 중 한 가지만 채우면 됩니다.
#
# (가) Resend — 따로 설치할 것 없이 바로 됩니다
RESEND_API_KEY=
#
# (나) SMTP — 학교 메일 서버 등을 쓸 때
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# 메일에 넣을 링크의 앞부분. 비워두면 접속한 주소를 그대로 씁니다.
# 예: https://anchor-certificate.vercel.app
APP_URL=

# ── 배포 (Vercel) ──
VERCEL_TOKEN=
